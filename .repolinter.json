{
  "name": "SentiBot AI Repository Linter Configuration",
  "rules": {
    "license-file-exists": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "files": ["LICENSE", "LICENSES/MIT.txt", "REUSE.toml"]
      }
    },
    "readme-file-exists": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "files": ["README.md", "AGENTS.md", "CONTEXT.md"]
      }
    },
    "contributing-file-exists": {
      "level": "warning",
      "rule": {
        "type": "file-existence",
        "files": ["CONTRIBUTING.md", "GIT_WORKFLOW.md"]
      }
    }
  }
}
